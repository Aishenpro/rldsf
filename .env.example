# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
SITE_URL=https://www.example.org
# Long random string (>= 32 chars). Generate: node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"hex\"))"
SESSION_SECRET=
DB_FILE=./database/foundation.sqlite
# Set true only when running behind a reverse proxy (nginx, Caddy, Cloudflare)
TRUST_PROXY=false

# Public contact details (leave blank to hide)
ORG_EMAIL=
ORG_PHONE=
ORG_LOCATION=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_X=
SOCIAL_YOUTUBE=

# Payments (leave blank to disable a method)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Shown to donors who choose these methods
BANK_TRANSFER_DETAILS=
MOBILE_MONEY_DETAILS=
